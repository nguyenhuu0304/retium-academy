# Set these in .env.local for local development and in Vercel Project Settings > Environment Variables.
# NEVER prefix SUPABASE_SECRET_KEY with NEXT_PUBLIC_ or commit a real secret.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
CERTIFICATE_SECRET=YOUR_LONG_RANDOM_CERTIFICATE_SECRET
NEXT_PUBLIC_SITE_URL=https://your-retium-academy.vercel.app
